<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portal tests: authorization, anti-forgery, session and cookie behaviour. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Generates authenticator codes, so the sign-in tests exercise the real
         second factor rather than disabling it. -->
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Attendance.Admin\Attendance.Admin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One definition of the database the suite runs against, and of the
         waiting limits that keep these tests honest on a loaded machine. -->
    <Compile Include="..\Shared\TestEnvironment.cs" Link="TestEnvironment.cs" />
  </ItemGroup>

</Project>
