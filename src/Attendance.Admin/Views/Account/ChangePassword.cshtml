@model Attendance.Admin.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<h1>Change your password</h1>

@if (Model.IsRequired)
{
    <p class="warning">
        Your password was issued by someone else, so it has to be changed before
        you can do anything else in the portal.
    </p>
}

<p>
    Use at least @Attendance.Application.Services.AdministratorPasswordPolicy.MinimumLength characters.
    Length matters far more than symbols: a few ordinary words with spaces between
    them is stronger than a short string of punctuation, and easier to type.
</p>

<p>
    Changing it signs you out everywhere else you are signed in. This window stays
    signed in.
</p>

<form method="post" asp-action="ChangePassword" autocomplete="off">
    <div asp-validation-summary="All" class="validation-summary"></div>

    @* None of these fields is ever filled back in after a failed attempt: a
       password in a rendered page is a password in the browser's history (§24). *@
    <div class="field">
        <label asp-for="CurrentPassword"></label>
        <input asp-for="CurrentPassword" type="password" value="" autocomplete="current-password" autofocus />
    </div>

    <div class="field">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" type="password" value="" autocomplete="new-password"
               maxlength="@Attendance.Application.Services.AdministratorPasswordPolicy.MaximumLength" />
    </div>

    <div class="field">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" value="" autocomplete="new-password"
               maxlength="@Attendance.Application.Services.AdministratorPasswordPolicy.MaximumLength" />
    </div>

    <button type="submit">Change password</button>
</form>
