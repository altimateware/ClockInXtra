<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Attendance.Infrastructure — Dapper repositories, cryptography, TOTP,
    attestation verification and platform services.

    Every database call goes through a stored procedure (Claude.md §4). There
    is no SQL text in this project beyond procedure names.

    The FrameworkReference gives access to ASP.NET Core Data Protection, which
    protects TOTP secrets at rest (TD-06), without dragging in the whole web
    stack as NuGet packages.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Otp.NET" />
    <!--
      No PackageReference for System.Formats.Cbor or System.Formats.Asn1.
      Both ship in the .NET 10 shared framework, and referencing them as
      packages is redundant (NU1510). CBOR decodes Apple App Attest
      attestation objects (OPEN-33); ASN.1 parses Android key attestation
      certificate extensions.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Attendance.Application\Attendance.Application.csproj" />
    <ProjectReference Include="..\Attendance.Domain\Attendance.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The database scripts travel with the assembly, so a published application
      cannot be separated from the schema it expects. The logical name keeps the
      path, because database/deploy/01_run_all.sql refers to its includes by
      path and that list is the single source of the deployment order.

      database/tests is excluded: a smoke suite is not part of a deployment.
    -->
    <EmbeddedResource Include="..\..\database\**\*.sql" Exclude="..\..\database\tests\**\*.sql">
      <LogicalName>db/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
