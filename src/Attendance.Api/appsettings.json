{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/attendance-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },

  "SqlServer": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 15
  },

  "Database": {
    "Name": "ClockInXtra",
    "ConnectionString": "",
    "LockTimeoutSeconds": 300,
    "CommandTimeoutSeconds": 180
  },

  "DataProtection": {
    "KeyRingPath": "",
    "CertificateThumbprint": "",
    "PreviousCertificateThumbprints": []
  },

  "Api": {
    "KnownProxies": [],
    "RateLimits": {
      "AttendancePerMinute": 10,
      "RegistrationPerMinute": 5,
      "ReadPerMinute": 60,
      "WindowSeconds": 60
    },
    "Abuse": {
      "SignatureFailuresPerAddressPerMinute": 60,
      "WindowSeconds": 60
    }
  },

  "Attestation": {
    "Android": {
      "RootCertificatePemPath": "",
      "ExpectedPackageName": "",
      "ExpectedSigningCertificateDigests": [],
      "RequireStrongBox": false,
      "RequireVerifiedBoot": true,
      "RevocationStatusListPath": ""
    },
    "Apple": {
      "RootCertificatePemPath": "",
      "TeamId": "",
      "BundleId": "",
      "AllowDevelopmentEnvironment": false
    }
  },

  "AllowedHosts": "*"
}
