<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Attendance.Api — the internet-facing mobile attendance API (DEC-03).

    Note what is NOT referenced here: Microsoft.OpenApi. It arrives as a
    transitive dependency of Microsoft.AspNetCore.OpenApi and is pinned to a
    non-vulnerable version centrally in Directory.Packages.props
    (CVE-2026-49451). Adding a direct reference here would hide that.
  -->

  <PropertyGroup>
    <UserSecretsId>clockinxtra-api</UserSecretsId>
    <!-- Build-time OpenAPI document generation, so the contract can be linted
         and diffed in CI rather than only inspected at runtime. -->
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- The signature parser and base builder are implementation details, not
         API surface, but they are the pieces where one wrong byte rejects every
         genuine request. They are tested directly rather than only through HTTP. -->
    <InternalsVisibleTo Include="Attendance.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Attendance.Application\Attendance.Application.csproj" />
    <ProjectReference Include="..\Attendance.Domain\Attendance.Domain.csproj" />
    <ProjectReference Include="..\Attendance.Infrastructure\Attendance.Infrastructure.csproj" />
  </ItemGroup>

</Project>
