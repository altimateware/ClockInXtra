{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },

  "SqlServer": {
    "ConnectionString": "Server=.;Database=ClockInXtra;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True"
  },

  "Attestation": {
    "Android": {
      "ExpectedPackageName": "com.altimateware.clockinxtra"
    },
    "Apple": {
      "TeamId": "DEVELOPMENT",
      "BundleId": "com.altimateware.clockinxtra",
      "AllowDevelopmentEnvironment": true
    }
  }
}
